{
  "name": "api",
  "version": "1.0.0",
  "description": "REST API with Fastify, PostgreSQL, and node-pg-migrate",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^5.2.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.8",
    "node-pg-migrate": "^7.3.2",
    "ts-jest": "^29.1.5",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.15.6",
    "typescript": "5.5.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "*.ts": [
      "bash -c 'tsc --noEmit -p .'"
    ]
  }
}
